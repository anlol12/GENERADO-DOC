# Manual: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=
